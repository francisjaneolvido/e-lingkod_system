# TEMPLATE ONLY - never put real credentials in a committed file.
# Use hexadecimal secrets generated with node:crypto to keep DATABASE_URL syntax safe.
DOCKER_MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
DOCKER_MYSQL_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
DOCKER_BETTER_AUTH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX

# PR #21: OPTIONAL for basic startup/public homepage, REQUIRED for actual new civic photo submissions.
# Keep any real API key in the ignored .env.docker.local only.
DOCKER_OPENAI_API_KEY=
DOCKER_OPENAI_VISION_MODEL=gpt-4o-mini
# Optional: reverse-geocoding; manual barangay/address entry works without it.
DOCKER_GEOAPIFY_API_KEY=
