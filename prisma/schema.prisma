// E-Lingkod Bayan — Auth & role foundation (Prisma 7 + MySQL)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// IMPORTANT: role is SERVER-OWNED. New registrations are CITIZEN only.
model User {
  id            String    @id @db.VarChar(191)
  name          String    @db.VarChar(191)
  // Structured fields for new citizens. Nullable for legacy, invited staff and seed admin accounts.
  firstName     String?   @db.VarChar(100)
  lastName      String?   @db.VarChar(100)
  middleInitial String?   @db.VarChar(1)
  hasNoMiddleName Boolean @default(false)
  phoneNumber   String?   @db.VarChar(13) // +639XXXXXXXXX
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          String    @default("CITIZEN") @db.VarChar(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  reports       CivicReport[] @relation("ReportedCivicReports")
  assignedCivicReports CivicReport[] @relation("AssignedCivicReports")
  reportUpdates ReportUpdate[]
  resolutionSubmissions ResolutionSubmission[] @relation("ResolutionSubmittedBy")
  resolutionReviews ResolutionSubmission[] @relation("ResolutionReviewedBy")
  department    String?  @db.VarChar(120)
  designation   String?  @db.VarChar(120)
  staffPermissions StaffPermission[]
  staffChangesMade StaffAccessAudit[] @relation("StaffAuditActor")
  staffChangesReceived StaffAccessAudit[] @relation("StaffAuditTarget")
  issuedStaffInvites StaffInvitation[] @relation("StaffInviteIssuer")
  citizenFeedbacks CitizenResolutionFeedback[] @relation("CitizenFeedbackReporter")
  jobseekerProfile JobseekerProfile?
  postedJobs JobOpportunity[] @relation("JobPostedBy")
  jobChanges JobActivity[] @relation("JobActivityActor")
  reviewedJobs JobOpportunity[] @relation("JobReviewedBy")
  spesImports SpesImportBatch[] @relation("SpesImportedBy")
  spesImportEvents SpesImportEvent[] @relation("SpesImportEventActor")
  communitySurveys CommunitySurvey[]
  communitySurveyWorkspaces CommunitySurveyWorkspace[]
  communitySurveyRevisions CommunitySurveyRevision[] @relation("CommunitySurveyRevisionOwner")
  authoredCommunitySurveyRevisions CommunitySurveyRevision[] @relation("CommunitySurveyRevisionActor")
  citizenProfileConsent CitizenProfileConsent?
  communityImports CommunityImportBatch[] @relation("CommunityImportedBy")
  serviceRequests ServiceRequest[] @relation("ServiceRequestedBy")
  assignedServiceRequests ServiceRequest[] @relation("ServiceAssignedStaff")
  serviceRequestEvents ServiceRequestEvent[] @relation("ServiceRequestEventActor")
  proposedServiceAppointments ServiceAppointment[] @relation("ServiceAppointmentProposedBy")
  proposedServicePickupSlots ServicePickupSlot[] @relation("ServicePickupProposedBy")
  verifiedServiceDocuments ServiceRequestDocument[] @relation("ServiceDocumentVerifiedBy")
  approvedServiceReleases ServiceRequest[] @relation("ServiceReleaseApprovedBy")
  notifications Notification[]
  workAssignments WorkAssignment[] @relation("WorkAssignmentStaff")
  createdServiceDefinitions ServiceDefinition[] @relation("ServiceDefinitionCreator")
  serviceDefinitionAudits ServiceDefinitionAudit[] @relation("ServiceDefinitionAuditActor")
  municipalProjectsCreated MunicipalProject[] @relation("MunicipalProjectAuthor")
  municipalProjectsReviewed MunicipalProject[] @relation("MunicipalProjectReviewer")
  municipalProjectUpdatesCreated MunicipalProjectUpdate[] @relation("MunicipalProjectUpdateAuthor")
  municipalProjectUpdatesReviewed MunicipalProjectUpdate[] @relation("MunicipalProjectUpdateReviewer")

  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(191)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(191)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @db.VarChar(191)
  identifier String    @db.VarChar(191)
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportVisibility {
  PUBLIC
  INTERNAL
}

enum CivicReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  PENDING_VERIFICATION
  RESOLVED
  REJECTED
  REOPENED
}

model CivicReport {
  id             String            @id @default(cuid()) @db.VarChar(191)
  trackingId     String            @unique @db.VarChar(48)
  submissionKey  String            @db.VarChar(64)
  reporterId     String            @db.VarChar(191)
  reporter       User              @relation("ReportedCivicReports", fields: [reporterId], references: [id], onDelete: Restrict)
  category       String            @db.VarChar(40)
  title          String            @db.VarChar(120)
  description    String            @db.Text
  barangay       String            @db.VarChar(100)
  address        String            @db.VarChar(300)
  latitude       Float?
  longitude      Float?
  locationSource String            @default("ADDRESS") @db.VarChar(12)
  gpsAccuracy    Float?
  status         CivicReportStatus @default(SUBMITTED)
  assignedOffice String?           @db.VarChar(120)
  assignedStaffId String?          @db.VarChar(191)
  assignedStaff   User?            @relation("AssignedCivicReports", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  priority       ReportPriority    @default(NORMAL)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  photos         ReportPhoto[]
  updates        ReportUpdate[]
  resolutionSubmissions ResolutionSubmission[]
  citizenFeedbacks CitizenResolutionFeedback[]

  @@unique([reporterId, submissionKey])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([assignedOffice, assignedStaffId, status])
  @@index([priority, createdAt])
  @@map("civic_report")
}

model ReportPhoto {
  id        String      @id @default(cuid()) @db.VarChar(191)
  reportId  String      @db.VarChar(191)
  report    CivicReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mimeType  String      @default("image/jpeg") @db.VarChar(40)
  byteSize  Int
  data      Bytes       @db.MediumBlob
  createdAt DateTime    @default(now())

  @@index([reportId])
  @@map("report_photo")
}

model ReportUpdate {
  id             String            @id @default(cuid()) @db.VarChar(191)
  reportId       String            @db.VarChar(191)
  report         CivicReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId        String?           @db.VarChar(191)
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  status         CivicReportStatus
  assignedOffice String?           @db.VarChar(120)
  note           String            @db.Text
  visibility     ReportVisibility  @default(PUBLIC)
  action         String            @default("STATUS") @db.VarChar(24)
  priority       ReportPriority?
  assignedStaffId String?          @db.VarChar(191)
  createdAt      DateTime          @default(now())

  @@index([reportId, createdAt])
  @@map("report_update")
}

// Access is granted ONLY by an existing administrator from the server.
// The role column remains the source of truth: STAFF + one or more module grants.
model StaffPermission {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String   @db.VarChar(32)
  grantedAt DateTime @default(now())

  @@unique([userId, module])
  @@index([module])
  @@map("staff_permission")
}

model StaffAccessAudit {
  id           String   @id @default(cuid()) @db.VarChar(191)
  actorId      String   @db.VarChar(191)
  targetUserId String   @db.VarChar(191)
  action       String   @db.VarChar(40)
  details      String   @db.Text
  createdAt    DateTime @default(now())
  actor        User     @relation("StaffAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target       User     @relation("StaffAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("staff_access_audit")
}

// An invitation is NOT a login account. Its one-time token is stored only as a hash.
// Role and module access become active only after successful password activation.
model StaffInvitation {
  id           String   @id @default(cuid()) @db.VarChar(191)
  email        String   @unique @db.VarChar(191)
  name         String   @db.VarChar(191)
  department   String   @db.VarChar(120)
  designation  String   @db.VarChar(120)
  modulesJson  String   @db.Text
  tokenHash    String   @unique @db.VarChar(64)
  issuedById   String   @db.VarChar(191)
  issuedBy     User     @relation("StaffInviteIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  expiresAt    DateTime
  activatedAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@map("staff_invitation")
}

// Each proof package belongs to a specific verification attempt. Pending or
// returned evidence is private to authorized LGU staff; approved evidence is
// shown to the reporting citizen when the report is officially resolved.
enum ResolutionReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

model ResolutionSubmission {
  id           String                 @id @default(cuid()) @db.VarChar(191)
  reportId     String                 @db.VarChar(191)
  report       CivicReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  submittedById String                @db.VarChar(191)
  submittedBy  User                   @relation("ResolutionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  remarks      String                 @db.Text
  reviewStatus ResolutionReviewStatus @default(PENDING)
  reviewedById String?                @db.VarChar(191)
  reviewedBy   User?                  @relation("ResolutionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?                @db.Text
  createdAt    DateTime               @default(now())
  reviewedAt   DateTime?
  photos       ResolutionProofPhoto[]
  citizenFeedback CitizenResolutionFeedback?

  @@index([reportId, createdAt])
  @@index([submittedById])
  @@map("resolution_submission")
}

model ResolutionProofPhoto {
  id           String               @id @default(cuid()) @db.VarChar(191)
  submissionId String               @db.VarChar(191)
  submission   ResolutionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mimeType     String               @default("image/jpeg") @db.VarChar(40)
  byteSize     Int
  data         Bytes                @db.MediumBlob
  createdAt    DateTime             @default(now())

  @@index([submissionId])
  @@map("resolution_proof_photo")
}

// One citizen response per approved proof package. A dispute reopens the case
// without deleting the original resolution photos or admin approval record.
enum CitizenFeedbackDecision {
  CONFIRMED
  DISPUTED
}

model CitizenResolutionFeedback {
  id                     String @id @default(cuid()) @db.VarChar(191)
  reportId               String @db.VarChar(191)
  report                 CivicReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  resolutionSubmissionId String @unique @db.VarChar(191)
  resolutionSubmission   ResolutionSubmission @relation(fields: [resolutionSubmissionId], references: [id], onDelete: Restrict)
  reporterId             String @db.VarChar(191)
  reporter               User @relation("CitizenFeedbackReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  decision               CitizenFeedbackDecision
  reason                 String? @db.Text
  createdAt              DateTime @default(now())
  photos                 CitizenFeedbackPhoto[]

  @@index([reportId, createdAt])
  @@index([reporterId])
  @@map("citizen_resolution_feedback")
}

model CitizenFeedbackPhoto {
  id          String @id @default(cuid()) @db.VarChar(191)
  feedbackId  String @db.VarChar(191)
  feedback    CitizenResolutionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  mimeType    String @default("image/jpeg") @db.VarChar(40)
  byteSize    Int
  data        Bytes @db.MediumBlob
  createdAt   DateTime @default(now())

  @@index([feedbackId])
  @@map("citizen_feedback_photo")
}


// V10: PESO-curated opportunities, NOT direct employment applications.
enum JobListingStatus {
  DRAFT
  PENDING_REVIEW
  RETURNED
  PUBLISHED
  CLOSED
  FILLED
  ARCHIVED
}

model JobOpportunity {
  id             String @id @default(cuid()) @db.VarChar(191)
  title          String @db.VarChar(150)
  employer       String @db.VarChar(150)
  sector         String @db.VarChar(80)
  workType       String @db.VarChar(30)
  barangay       String @db.VarChar(100)
  location       String @db.VarChar(180)
  description    String @db.Text
  skillsJson     String @db.Text
  interestsJson  String @db.Text
  education      String @db.VarChar(40)
  contactInfo    String @db.VarChar(250)
  externalUrl    String? @db.VarChar(500)
  status         JobListingStatus @default(DRAFT)
  version        Int @default(1)
  reviewSource   String? @db.VarChar(300) // staff's internal employer/vacancy source, never public
  reviewRequestedAt DateTime?
  reviewedAt     DateTime?
  reviewedById   String? @db.VarChar(191)
  reviewedBy     User? @relation("JobReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String? @db.Text
  employerVerified Boolean @default(false)
  vacancyVerified Boolean @default(false)
  expiresAt      DateTime?
  publishedAt    DateTime?
  createdById    String @db.VarChar(191)
  createdBy      User @relation("JobPostedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activities     JobActivity[]

  @@index([status, publishedAt])
  @@index([sector, workType])
  @@map("job_opportunity")
}

// A profile is strictly optional and belongs only to its signed-in citizen.
// No CV, phone number, salary expectation, or application record is stored.
model JobseekerProfile {
  userId         String @id @db.VarChar(191)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillsJson     String @db.Text
  interestsJson  String @db.Text
  education      String @db.VarChar(40)
  preferredArea  String @db.VarChar(100)
  availability   String @db.VarChar(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("jobseeker_profile")
}

// Do not store respondent names, emails, exact addresses or phone numbers.
// Import is restricted to datasets with explicit use-for-insights consent.
model SpesImportBatch {
  id             String @id @default(cuid()) @db.VarChar(191)
  sourceLabel    String @db.VarChar(120)
  importedById   String @db.VarChar(191)
  importedBy     User @relation("SpesImportedBy", fields: [importedById], references: [id], onDelete: Restrict)
  recordCount    Int
  datasetKind    String @default("UNCLASSIFIED") @db.VarChar(20)
  fingerprint    String? @unique @db.VarChar(64)
  status         String @default("ACTIVE") @db.VarChar(16)
  voidedAt       DateTime?
  voidedById     String? @db.VarChar(191)
  voidReason     String? @db.VarChar(500)
  createdAt      DateTime @default(now())
  records        SpesSurveyRecord[]
  events         SpesImportEvent[]
  @@index([createdAt])
  @@index([status, datasetKind])
  @@map("spes_import_batch")
}

model SpesSurveyRecord {
  id             String @id @default(cuid()) @db.VarChar(191)
  batchId        String @db.VarChar(191)
  batch          SpesImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  barangay       String @db.VarChar(100)
  education      String @db.VarChar(40)
  skillsJson     String @db.Text
  interestsJson  String @db.Text
  availability   String @db.VarChar(30)
  @@index([batchId])
  @@map("spes_survey_record")
}

model SpesImportEvent {
  id        String @id @default(cuid()) @db.VarChar(191)
  batchId   String @db.VarChar(191)
  batch     SpesImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actorId   String @db.VarChar(191)
  actor     User @relation("SpesImportEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String @db.VarChar(30)
  note      String? @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([batchId, createdAt])
  @@map("spes_import_event")
}

model JobActivity {
  id          String @id @default(cuid()) @db.VarChar(191)
  jobId       String @db.VarChar(191)
  job         JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId     String @db.VarChar(191)
  actor       User @relation("JobActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  action      String @db.VarChar(30)
  note        String? @db.Text
  previousStatus String? @db.VarChar(30)
  nextStatus  String? @db.VarChar(30)
  createdAt   DateTime @default(now())
  @@index([jobId, createdAt])
  @@map("job_activity")
}


// V11: Community employment, skills, training, livelihood and SDG 16 profiling.
// Citizen survey responses are kept separate from historical/government imports.
model CommunitySurvey {
  id                               String   @id @default(cuid()) @db.VarChar(191)
  userId                           String   @db.VarChar(191)
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surveyYear                       Int
  surveyVersion                    Int      @default(1)
  status                           String   @default("DRAFT") @db.VarChar(20)
  barangay                         String   @db.VarChar(100)
  ageGroup                         String   @db.VarChar(30)
  sex                              String?  @db.VarChar(30)
  civilStatus                      String?  @db.VarChar(30)
  pwdStatus                        String?  @db.VarChar(30)
  householdSize                    Int?
  employmentHistory                String?  @db.Text
  overseasExperience               String?  @db.VarChar(20)
  qualificationsJson               String   @default("[]") @db.Text
  completedTrainingJson            String   @default("[]") @db.Text
  currentlyStudying                Boolean?
  educationLevel                   String   @db.VarChar(40)
  employmentStatus                 String   @db.VarChar(50)
  occupation                       String?  @db.VarChar(150)
  industry                         String?  @db.VarChar(120)
  workArrangement                  String?  @db.VarChar(40)
  workLocationScope                String?  @db.VarChar(50)
  employmentLength                 String?  @db.VarChar(50)
  workRelatedToEducation           Boolean?
  interestedNewWork                Boolean?
  skillsJson                       String   @db.Text
  skillLevelsJson                  String   @db.Text
  trainingInterest                 String?  @db.VarChar(20)
  trainingCategoriesJson           String   @db.Text
  trainingProgramsJson             String   @db.Text
  trainingReason                   String?  @db.VarChar(60)
  trainingBarriersJson             String   @db.Text
  employmentBarriersJson           String   @db.Text
  preferredOccupationsJson         String   @db.Text
  preferredIndustry                String?  @db.VarChar(120)
  preferredWorkArrangement         String?  @db.VarChar(40)
  preferredWorkLocation            String?  @db.VarChar(120)
  willingOutsideMunicipality       Boolean?
  interestedGovPrograms            Boolean?
  interestedLivelihood             Boolean?
  interestedEntrepreneurship       Boolean?
  businessType                     String?  @db.VarChar(120)
  businessSector                   String?  @db.VarChar(120)
  businessLocationType             String?  @db.VarChar(40)
  businessSize                     String?  @db.VarChar(30)
  businessRegistered               String?  @db.VarChar(30)
  businessYears                    String?  @db.VarChar(30)
  businessChallengesJson           String   @db.Text
  businessSupportJson              String   @db.Text
  programAwareness                 String?  @db.VarChar(20)
  informationAccess                String?  @db.VarChar(20)
  participatedConsultation         String?  @db.VarChar(20)
  inclusivePlanning                String?  @db.VarChar(30)
  priorityProgramsJson             String   @db.Text
  publicServiceBarriersJson        String   @db.Text
  serviceSatisfaction              Int?
  feedback                         String?  @db.Text
  consentAggregated                Boolean  @default(false)
  consentOpportunityRecommendations Boolean @default(false)
  consentProgramRecommendations    Boolean  @default(false)
  submittedAt                      DateTime?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@unique([userId, surveyYear])
  @@index([surveyYear, status])
  @@index([barangay, surveyYear])
  @@index([employmentStatus, surveyYear])
  @@index([educationLevel, surveyYear])
  @@map("community_survey")
}

// V11 citizen history/consent: schema definitions for the existing
// 20261023030000_citizen_profile_history migration (no new tables added here).
model CommunitySurveyWorkspace {
  id         String   @id @default(cuid()) @db.VarChar(191)
  userId     String   @db.VarChar(191)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surveyYear Int
  version    Int      @default(0)
  draftJson  String?  @db.LongText
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, surveyYear])
  @@map("community_survey_workspace")
}

model CommunitySurveyRevision {
  id            String   @id @default(cuid()) @db.VarChar(191)
  userId        String   @db.VarChar(191)
  user          User     @relation("CommunitySurveyRevisionOwner", fields: [userId], references: [id], onDelete: Restrict)
  actorId       String   @db.VarChar(191)
  actor         User     @relation("CommunitySurveyRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  surveyYear    Int
  revision      Int
  action        String   @db.VarChar(20)
  schemaVersion Int      @default(2)
  requestKey    String   @db.VarChar(80)
  payloadHash   String   @db.VarChar(64)
  resultVersion Int
  answersJson   String   @db.LongText
  createdAt     DateTime @default(now())

  @@unique([userId, requestKey])
  @@unique([userId, surveyYear, revision])
  @@index([userId, surveyYear, createdAt])
  @@map("community_survey_revision")
}

model CitizenProfileConsent {
  userId    String   @id @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matching  Boolean  @default(false)
  programs  Boolean  @default(false)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("citizen_profile_consent")
}

model GovernmentActivity {
  id                String   @id @default(cuid()) @db.VarChar(191)
  activityName      String   @db.VarChar(180)
  activityType      String   @db.VarChar(60)
  implementingOffice String  @db.VarChar(150)
  activityDate      DateTime?
  coverage          String?  @db.VarChar(180)
  originalPurpose   String?  @db.Text
  originalDataSource String? @db.VarChar(180)
  intendedUse       String   @default("INTERNAL_STATISTICS") @db.VarChar(40)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  batches           CommunityImportBatch[]

  @@index([activityType, activityDate])
  @@map("government_activity")
}

model CommunityImportBatch {
  id             String   @id @default(cuid()) @db.VarChar(191)
  activityId     String   @db.VarChar(191)
  activity       GovernmentActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  importedById   String   @db.VarChar(191)
  importedBy     User     @relation("CommunityImportedBy", fields: [importedById], references: [id], onDelete: Restrict)
  sourceFilename String   @db.VarChar(220)
  fileType       String   @db.VarChar(20)
  fingerprint    String?  @unique @db.VarChar(64)
  recordCount    Int      @default(0)
  validCount     Int      @default(0)
  invalidCount   Int      @default(0)
  warningCount   Int      @default(0)
  duplicateCount Int      @default(0)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now())
  records        CommunityImportRecord[]

  @@index([activityId, createdAt])
  @@index([status, createdAt])
  @@map("community_import_batch")
}

model CommunityImportRecord {
  id                     String   @id @default(cuid()) @db.VarChar(191)
  batchId                String   @db.VarChar(191)
  batch                  CommunityImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  originalRowNumber      Int
  participantRef         String?  @db.VarChar(191)
  barangay               String?  @db.VarChar(100)
  ageGroup                String?  @db.VarChar(30)
  educationLevel          String?  @db.VarChar(40)
  employmentStatus        String?  @db.VarChar(50)
  occupation              String?  @db.VarChar(150)
  industry                String?  @db.VarChar(120)
  skillsJson              String   @db.Text
  trainingInterest        String?  @db.VarChar(20)
  trainingCategoriesJson String   @db.Text
  trainingProgramsJson   String   @db.Text
  trainingBarriersJson   String   @db.Text
  employmentBarriersJson String   @db.Text
  businessSector         String?  @db.VarChar(120)
  assistanceNeededJson   String   @db.Text
  rawJson                 String   @db.LongText
  qualityFlagsJson        String   @db.Text
  createdAt               DateTime @default(now())

  @@index([batchId])
  @@index([barangay])
  @@index([employmentStatus])
  @@map("community_import_record")
}

// Online LGU Services — citizen requests, assignment, validation, scheduling and release.
// Service definitions/questions remain code-configured so LGU-specific requirements can be adjusted safely.
model ServiceRequest {
  id                 String   @id @default(cuid()) @db.VarChar(191)
  trackingId         String   @unique @db.VarChar(48)
  serviceKey         String   @db.VarChar(80)
  serviceTitle       String   @db.VarChar(180)
  requesterId        String   @db.VarChar(191)
  requester          User     @relation("ServiceRequestedBy", fields: [requesterId], references: [id], onDelete: Restrict)
  purpose            String   @db.Text
  formDataJson       String   @db.LongText
  status             String   @default("DRAFT") @db.VarChar(40)
  assignedDepartment String?  @db.VarChar(150)
  assignedStaffId    String?  @db.VarChar(191)
  assignedStaff      User?    @relation("ServiceAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  staffRecommendation String? @db.Text
  releaseNote        String?  @db.Text
  finalNote          String?  @db.Text
  releaseApprovedAt  DateTime?
  releaseApprovedById String? @db.VarChar(191)
  releaseApprovedBy  User? @relation("ServiceReleaseApprovedBy", fields: [releaseApprovedById], references: [id], onDelete: SetNull)
  version            Int      @default(1)
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  documents          ServiceRequestDocument[]
  events             ServiceRequestEvent[]
  appointments       ServiceAppointment[]
  pickupSlots        ServicePickupSlot[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([assignedDepartment, assignedStaffId, status])
  @@index([serviceKey, status])
  @@index([releaseApprovedById])
  @@map("service_request")
}

model ServiceRequestDocument {
  id             String         @id @default(cuid()) @db.VarChar(191)
  requestId      String         @db.VarChar(191)
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requirementKey String         @db.VarChar(100)
  requirementLabel String       @db.VarChar(180)
  fileName       String         @db.VarChar(220)
  mimeType       String         @db.VarChar(80)
  byteSize       Int
  data           Bytes          @db.MediumBlob
  uploadedAt     DateTime       @default(now())
  verificationStatus String     @default("PENDING") @db.VarChar(24)
  verificationNote   String?    @db.Text
  verifiedById       String?    @db.VarChar(191)
  verifiedBy         User?      @relation("ServiceDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?

  @@index([requestId, requirementKey])
  @@index([verificationStatus, uploadedAt])
  @@index([verifiedById])
  @@map("service_request_document")
}

model ServiceRequestEvent {
  id               String         @id @default(cuid()) @db.VarChar(191)
  requestId        String         @db.VarChar(191)
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId          String?        @db.VarChar(191)
  actor            User?          @relation("ServiceRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action           String         @db.VarChar(50)
  status           String         @db.VarChar(40)
  note             String         @db.Text
  visibleToCitizen Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([requestId, createdAt])
  @@map("service_request_event")
}

model ServiceAppointment {
  id             String         @id @default(cuid()) @db.VarChar(191)
  requestId      String         @db.VarChar(191)
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  location       String         @db.VarChar(220)
  agenda         String         @db.Text
  status         String         @default("PROPOSED") @db.VarChar(30)
  proposedById   String         @db.VarChar(191)
  proposedBy     User           @relation("ServiceAppointmentProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  citizenNote    String?        @db.Text
  staffNote      String?        @db.Text
  confirmedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([requestId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("service_appointment")
}


// Physical document collection is separate from interviews and inspections.
// Slots do not mutate the main ServiceRequest status while awaiting citizen selection.
model ServicePickupSlot {
  id             String         @id @default(cuid()) @db.VarChar(191)
  requestId      String         @db.VarChar(191)
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  location       String         @db.VarChar(220)
  instructions   String         @db.Text
  status         String         @default("PROPOSED") @db.VarChar(30)
  proposedById   String         @db.VarChar(191)
  proposedBy     User           @relation("ServicePickupProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  citizenNote    String?        @db.Text
  claimantName   String?        @db.VarChar(180)
  confirmedAt    DateTime?
  claimedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([requestId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("service_pickup_slot")
}

// V16 — shared notifications, fair work distribution and configurable Online LGU Services.
model Notification {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String   @db.VarChar(32)
  type      String   @db.VarChar(48)
  title     String   @db.VarChar(180)
  message   String   @db.Text
  href      String?  @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([module, createdAt])
  @@map("notification")
}

model WorkAssignment {
  id              String   @id @default(cuid()) @db.VarChar(191)
  module          String   @db.VarChar(32)
  entityType      String   @db.VarChar(40)
  entityId        String   @db.VarChar(191)
  department      String?  @db.VarChar(150)
  assignedStaffId String?  @db.VarChar(191)
  assignedStaff   User?    @relation("WorkAssignmentStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  status          String   @default("OPEN") @db.VarChar(24)
  claimDeadline   DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  completedAt     DateTime?
  attemptCount    Int      @default(0)
  lastOfferedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([module, entityType, entityId])
  @@index([assignedStaffId, status, claimDeadline])
  @@index([module, department, status, createdAt])
  @@map("work_assignment")
}

model ServiceDefinition {
  id                   String   @id @default(cuid()) @db.VarChar(191)
  key                  String   @unique @db.VarChar(80)
  title                String   @db.VarChar(180)
  shortTitle           String   @db.VarChar(100)
  category             String   @db.VarChar(80)
  processingOffice     String   @db.VarChar(150)
  departmentCode       String   @db.VarChar(80)
  description          String   @db.Text
  actionLabel          String   @db.VarChar(100)
  intakeMode           String   @db.VarChar(20)
  appointmentMode      String   @db.VarChar(20)
  completionMode       String   @db.VarChar(20)
  purposeLabel         String   @db.VarChar(160)
  purposePlaceholder   String?  @db.Text
  feeText              String?  @db.VarChar(160)
  processingTimeText   String?  @db.VarChar(160)
  assignmentStrategy   String   @default("AUTO_BALANCE") @db.VarChar(30)
  acceptTimeoutMinutes Int      @default(120)
  published            Boolean  @default(false)
  configJson           String   @db.LongText
  createdById          String   @db.VarChar(191)
