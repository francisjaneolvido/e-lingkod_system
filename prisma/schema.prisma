}

model ServiceDefinitionAudit {
  id                  String            @id @default(cuid()) @db.VarChar(191)
  serviceDefinitionId String            @db.VarChar(191)
  serviceDefinition   ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  actorId             String            @db.VarChar(191)
  actor               User              @relation("ServiceDefinitionAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action              String            @db.VarChar(40)
  snapshotJson        String            @db.LongText
  createdAt           DateTime          @default(now())

  @@index([serviceDefinitionId, createdAt])
  @@index([actorId, createdAt])
  @@map("service_definition_audit")
}

