# Copy to .env and choose your own local database credentials and auth secret.
DATABASE_URL=mysql://LOCAL_USER:ENCODED_LOCAL_PASSWORD@127.0.0.1:3306/e_lingkod_bayan
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: absolute path to THIS MySQL server's RSA public PEM.
# Leave blank when unnecessary. Forward slashes avoid Windows escape ambiguity.
# Example only: MYSQL_RSA_PUBLIC_KEY_PATH=C:/path/to/mysql-data/public_key.pem
MYSQL_RSA_PUBLIC_KEY_PATH=
